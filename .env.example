# Next.js app (repository root) — env template
#
# Primary template: Astro lives in writebolt-astro/ — copy writebolt-astro/.env.example
# and work from that folder for the recommended setup.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin UI (npm run setup will prompt for these)
ADMIN_USERNAME=yourusername
ADMIN_PASSWORD=yourpassword

# Encryption (for BYOK API key storage)
SETTINGS_ENCRYPTION_KEY=generate-a-random-32-byte-hex-string

# Optional — newsletter API (Mailchimp, Resend, etc. — wire in app/api/newsletter/subscribe/route.ts)
# NEWSLETTER_API_KEY=

# Optional: AI keys can also be set here instead of the admin UI
# OPENAI_API_KEY=
# REPLICATE_API_KEY=

# Public site origin used in sitemaps, RSS, and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional language code for the Google News sitemap (default: en)
# NEWS_LANGUAGE=en

# Optional — Writebolt ad network (components/WriteboltAd.tsx)
# NEXT_PUBLIC_WRITEBOLT_ADS_API_URL=https://api.writebolt.app
