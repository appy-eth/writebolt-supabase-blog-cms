---
import Base from '../layouts/Base.astro';
import { getArticleBySlug } from '../lib/data';
import { formatDate } from '../lib/utils';
import { marked } from 'marked';

const { slug } = Astro.params;
const article = await getArticleBySlug(slug!);

if (!article) {
  return Astro.redirect('/404');
}

const htmlContent = await marked.parse(article.content_markdown || '');
---

<Base title={article.headline} description={article.excerpt}>
  <article>
    <div class="article-header">
      {article.categories && (
        <div class="article-header__cat">
          <a href={`/category/${article.categories.slug}`}>{article.categories.name}</a>
        </div>
      )}
      <h1>{article.headline}</h1>
      <div class="article-header__meta">
        {article.authors?.name && <span>By {article.authors.name}</span>}
        {article.published_at && <span> · <time>{formatDate(article.published_at)}</time></span>}
      </div>
    </div>

    {article.featured_image && (
      <div class="article-hero">
        <img src={article.featured_image} alt={article.headline} />
      </div>
    )}

    <div class="prose" set:html={htmlContent} />
  </article>
</Base>
