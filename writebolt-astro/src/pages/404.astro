---
import Base from '../layouts/Base.astro';
import { publicPath } from '../lib/utils';
---

<Base title="Not Found">
  <div style="text-align: center; padding: 4rem 0;">
    <h1 style="font-family: var(--font-display); font-size: 4rem; font-weight: 400; margin-bottom: 0.5rem;">404</h1>
    <p style="color: var(--muted); font-size: 1.1rem; margin-bottom: 1.5rem;">This page doesn't exist.</p>
    <a href={publicPath('/')} class="btn">← Back Home</a>
  </div>
</Base>
