---
import Base from '../../layouts/Base.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import { getAuthors, getSiteSettings } from '../../lib/data';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { publicPath } from '../../lib/utils';

const authors = await getAuthors();
const settings = await getSiteSettings();
---

<Base title="Authors" description={`Meet the authors of ${settings.site_name}`}>
  <Breadcrumbs items={[{ label: 'Blog', href: publicPath('/') }, { label: 'Authors' }]} />
  <div class="authors-page">
    <h1>Authors</h1>
    <p class="listing-meta">Meet the people behind {settings.site_name}.</p>
    {authors.length === 0 ? (
      <p class="empty-state">No authors yet.</p>
    ) : (
      <div class="authors-grid">
        {authors.map((author) => (
          <AuthorCard author={author} />
        ))}
      </div>
    )}
  </div>
</Base>
