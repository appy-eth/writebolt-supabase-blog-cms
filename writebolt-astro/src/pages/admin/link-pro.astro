---
import Admin from '../../layouts/Admin.astro';
import { requireAuth } from '../../lib/auth';

const authRedirect = requireAuth(Astro.request);
if (authRedirect) return authRedirect;

const apiBase = String(
  import.meta.env.WRITEBOLT_PRO_API_URL || process.env.WRITEBOLT_PRO_API_URL || '',
).replace(/\/$/, '');
const apiKey = String(
  import.meta.env.WRITEBOLT_PRO_API_KEY || process.env.WRITEBOLT_PRO_API_KEY || '',
);
const connected = Boolean(apiBase && apiKey);

let error = '';
let notice = '';
let pages: { id: string; url: string; title: string; times_placed?: number }[] = [];

if (connected && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const res = await fetch(`${apiBase}/api/pro/link-pro`, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      url: form.get('url')?.toString() || '',
      title: form.get('title')?.toString() || '',
      description: form.get('description')?.toString() || '',
    }),
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) error = data.error || 'Could not add that page';
  else notice = 'Page added to Link Pro.';
}

if (connected) {
  const res = await fetch(`${apiBase}/api/pro/link-pro`, {
    headers: { Authorization: `Bearer ${apiKey}` },
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) error = error || data.error || 'Could not load Link Pro';
  else pages = data.pages || [];
}
---

<Admin title="Link Pro" active="link-pro">
  <div class="admin-header">
    <div>
      <h1>Link Pro</h1>
      <p class="admin-sub">Pages from this blog that other Writebolt articles can cite.</p>
    </div>
  </div>

  {!connected && (
    <div class="login-error" style="margin-bottom: 1rem;">
      Add <code>WRITEBOLT_PRO_API_URL</code> and <code>WRITEBOLT_PRO_API_KEY</code> to connect this blog to Writebolt Pro.
    </div>
  )}
  {error && <div class="login-error" style="margin-bottom: 1rem;">{error}</div>}
  {notice && <p class="admin-sub">{notice}</p>}

  {connected && (
    <form method="POST" style="display: grid; gap: 0.75rem; max-width: 36rem; margin-bottom: 1.5rem;">
      <input class="input" name="url" type="url" required placeholder="https://yoursite.com/article" />
      <input class="input" name="title" required placeholder="Page title" />
      <textarea class="input" name="description" rows="3" placeholder="What the page is about"></textarea>
      <button class="btn btn--primary" type="submit">Add page</button>
    </form>
  )}

  <ul style="display: grid; gap: 0.75rem; padding: 0; list-style: none;">
    {pages.map((page) => (
      <li style="border: 1px solid #e5e7eb; border-radius: 12px; padding: 0.9rem; background: white;">
        <strong>{page.title}</strong>
        <div><a href={page.url}>{page.url}</a></div>
        <p class="admin-sub">Cited {page.times_placed ?? 0} times</p>
      </li>
    ))}
  </ul>
</Admin>
