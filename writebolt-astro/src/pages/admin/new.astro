---
import Admin from '../../layouts/Admin.astro';
import ArticleForm from '../../components/ArticleForm.astro';
import { requireAuth } from '../../lib/auth';
import { adminGetCategories, adminGetAuthors, adminHasOpenAIKey } from '../../lib/data';
import { supabaseAdmin } from '../../lib/supabase';
import { articlePayloadFromForm } from '../../lib/article-form';
import { publicPath } from '../../lib/utils';

const authRedirect = requireAuth(Astro.request);
if (authRedirect) return authRedirect;

const categories = await adminGetCategories();
const authors = await adminGetAuthors();
const hasApiKey = await adminHasOpenAIKey();

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const payload = articlePayloadFromForm(form);
  const { error: dbError } = await supabaseAdmin.from('articles').insert(payload);
  if (dbError) error = dbError.message;
  else return Astro.redirect(publicPath('/admin'));
}
---

<Admin title="New Article" active="new">
  <div class="admin-header">
    <h1>New Article</h1>
  </div>
  {error && <div class="login-error" style="margin-bottom: 1rem;">{error}</div>}
  <form method="POST" data-article-form>
    <ArticleForm categories={categories} authors={authors} hasApiKey={hasApiKey} />
    <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
      <button type="submit" name="action" value="draft" class="btn">Save as Draft</button>
      <button type="submit" name="action" value="publish" class="btn btn--primary">Publish Now</button>
      <button type="submit" name="action" value="schedule" class="btn btn--accent">Schedule</button>
    </div>
  </form>
</Admin>
