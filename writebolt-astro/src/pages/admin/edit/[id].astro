---
import Admin from '../../../layouts/Admin.astro';
import ArticleForm from '../../../components/ArticleForm.astro';
import { requireAuth } from '../../../lib/auth';
import { adminGetArticle, adminGetCategories, adminGetAuthors, adminHasOpenAIKey } from '../../../lib/data';
import { supabaseAdmin } from '../../../lib/supabase';
import { articlePayloadFromForm } from '../../../lib/article-form';
import { publicPath } from '../../../lib/utils';

const authRedirect = requireAuth(Astro.request);
if (authRedirect) return authRedirect;

const { id } = Astro.params;
let article = await adminGetArticle(id!);
if (!article) return Astro.redirect(publicPath('/admin'));

const categories = await adminGetCategories();
const authors = await adminGetAuthors();
const hasApiKey = await adminHasOpenAIKey();

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action')?.toString() || '';

  if (action === 'delete') {
    await supabaseAdmin.from('articles').delete().eq('id', id);
    return Astro.redirect(publicPath('/admin'));
  }

  const payload = articlePayloadFromForm(form, { published_at: article.published_at });
  const { error: dbError } = await supabaseAdmin.from('articles').update(payload).eq('id', id);

  if (dbError) error = dbError.message;
  else return Astro.redirect(publicPath('/admin'));
}
---

<Admin title={`Edit: ${article.headline}`} active="articles">
  <div class="admin-header">
    <h1>Edit Article</h1>
    <span class={`status-badge status-badge--${article.status}`}>{article.status}</span>
  </div>
  {error && <div class="login-error" style="margin-bottom: 1rem;">{error}</div>}
  <form method="POST" data-article-form>
    <ArticleForm article={article} categories={categories} authors={authors} hasApiKey={hasApiKey} />
    <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap;">
      <button type="submit" name="action" value="draft" class="btn">Save as Draft</button>
      <button type="submit" name="action" value="publish" class="btn btn--primary">
        {article.status === 'published' ? 'Update & Publish' : 'Publish Now'}
      </button>
      <button type="submit" name="action" value="schedule" class="btn btn--accent">Schedule</button>
      {article.status !== 'archived' && (
        <button type="submit" name="action" value="archive" class="btn" style="margin-left: auto;">Archive</button>
      )}
      <button type="submit" name="action" value="delete" class="btn"
        style="color: var(--accent);"
        onclick="return confirm('Delete this article permanently?')">
        Delete
      </button>
    </div>
  </form>
</Admin>
