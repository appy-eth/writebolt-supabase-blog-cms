---
import Admin from '../../layouts/Admin.astro';
import { requireAuth } from '../../lib/auth';
import { adminGetAllArticles } from '../../lib/data';
import { formatDate } from '../../lib/utils';

const authRedirect = requireAuth(Astro.request);
if (authRedirect) return authRedirect;

const articles = await adminGetAllArticles();
---

<Admin title="Articles" active="articles">
  <div class="admin-header">
    <h1>Articles</h1>
    <a href="/admin/new" class="btn btn--primary">+ New Article</a>
  </div>

  {articles.length === 0 ? (
    <div style="text-align: center; padding: 3rem; color: var(--muted);">
      <p>No articles yet. Create your first one!</p>
    </div>
  ) : (
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Status</th>
          <th>Updated</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {articles.map((a) => (
          <tr>
            <td>
              <strong>{a.headline}</strong>
              <div style="font-size: 0.8rem; color: var(--muted);">/{a.slug}</div>
            </td>
            <td>{a.categories?.name || '—'}</td>
            <td>
              <span class={`status-badge status-badge--${a.status}`}>
                {a.status}
              </span>
            </td>
            <td style="color: var(--muted); font-size: 0.85rem;">{formatDate(a.updated_at)}</td>
            <td>
              <a href={`/admin/edit/${a.id}`} class="btn btn--sm">Edit</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</Admin>
