---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Pagination from '../components/Pagination.astro';
import Sidebar from '../components/Sidebar.astro';
import {
  getPublishedArticles,
  getFeaturedCategoryArticles,
  getSiteSettings,
  getCategories,
} from '../lib/data';
import {
  blogJsonLd,
  shouldShowPageBlogTitle,
  isEmbeddedLayout,
  shouldShowFeaturedCategories,
  blogPageHeading,
} from '../lib/seo';
import CategoryFilter from '../components/CategoryFilter.astro';
import { publicPath } from '../lib/utils';

const settings = await getSiteSettings();
const categories = await getCategories();
const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') ?? '1', 10));
const searchQuery = url.searchParams.get('q') || undefined;
const perPage = settings.posts_per_page || 10;
const embedded = isEmbeddedLayout(settings);

const { articles, total } = await getPublishedArticles({
  limit: perPage,
  offset: (page - 1) * perPage,
  search: searchQuery,
});
const showFeatured = !searchQuery && shouldShowFeaturedCategories(settings);
const featured = showFeatured ? await getFeaturedCategoryArticles() : [];
const totalPages = Math.ceil(total / perPage);
const isSearching = !!searchQuery;
const showPageTitle = shouldShowPageBlogTitle(settings);
const searchBase = publicPath(searchQuery ? `/?q=${encodeURIComponent(searchQuery)}` : '/');
---

<Base jsonLd={blogJsonLd(settings)}>
  {showPageTitle && <h1 class="page-blog-title">{blogPageHeading(settings)}</h1>}

  {embedded && !isSearching && <CategoryFilter categories={categories} />}

  <div class="listing-layout">
    <div class="listing-main">
      {isSearching ? (
        <>
          <p class="listing-meta">
            {total} result{total !== 1 ? 's' : ''} for “{searchQuery}”
          </p>
          {articles.length > 0 ? (
            <div class="article-grid">
              {articles.map((article) => <ArticleCard article={article} />)}
            </div>
          ) : (
            <p class="empty-state">No articles found matching your search.</p>
          )}
        </>
      ) : (
        <>
          {articles.length > 0 ? (
            <div class="article-grid">
              {articles.map((article) => <ArticleCard article={article} />)}
            </div>
          ) : (
            <div class="empty-state empty-state--lg">
              <p>No articles published yet.</p>
              <p><a href="/admin/new">Write your first article →</a></p>
            </div>
          )}
        </>
      )}

      <Pagination currentPage={page} totalPages={totalPages} basePath={searchBase} />

      {!isSearching && featured.map(({ category, articles: catArticles }) => (
        <section class="featured-cat">
          <div class="featured-cat__head">
            <h2>{category.name}</h2>
            <a href={publicPath(`/category/${category.slug}`)}>View all →</a>
          </div>
          <div class="article-grid">
            {catArticles.map((article) => <ArticleCard article={article} />)}
          </div>
        </section>
      ))}
    </div>

    <Sidebar settings={settings} searchQuery={searchQuery || ''} />
  </div>
</Base>
