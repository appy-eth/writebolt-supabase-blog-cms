---
import HostLayout from 'virtual:writebolt/layout';
import StandaloneShell from './StandaloneShell.astro';
import JsonLd from '../components/JsonLd.astro';
import { getSiteSettings } from '../lib/data';
import { absoluteAssetUrl, blogBasePath, publicPath, siteUrl } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | null;
  ogType?: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | null;
  articlePublished?: string | null;
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  canonical,
  jsonLd,
  articlePublished,
} = Astro.props;

const host = HostLayout;
const Shell = host || StandaloneShell;
const settings = host ? await getSiteSettings() : null;
const pageDesc = description || settings?.site_description;
const origin = siteUrl();
const rawImage = ogImage || settings?.default_og_image;
const image = rawImage
  ? /^https?:\/\//i.test(rawImage)
    ? rawImage
    : absoluteAssetUrl(rawImage, origin) || new URL(rawImage, origin).href
  : undefined;
const mount = blogBasePath();
---

<Shell
  title={host ? (title || settings?.site_name) : title}
  description={host ? pageDesc : description}
  ogImage={ogImage}
  ogType={ogType}
  canonical={canonical}
  jsonLd={jsonLd}
  articlePublished={articlePublished}
  canonicalPath={Astro.url.pathname}
  image={image}
>
  {host && (
    <Fragment slot="head">
      <link rel="alternate" type="application/rss+xml" title={settings?.site_name} href={publicPath('/rss.xml')} />
      {articlePublished && <meta property="article:published_time" content={articlePublished} />}
      {jsonLd && <JsonLd data={jsonLd} />}
    </Fragment>
  )}
  <div class:list={['wb-blog', { 'page-wrap': Boolean(host) }]} data-wb-base={mount}>
    <slot />
  </div>
</Shell>
