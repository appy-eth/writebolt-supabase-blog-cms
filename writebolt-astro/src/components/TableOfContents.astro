<nav class="toc" data-toc aria-label="Table of contents" hidden>
  <button type="button" class="toc__toggle" data-toc-toggle aria-expanded="false" aria-controls="toc-list">
    Table of Contents
    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </button>
  <div class="toc__panel">
    <h4 class="toc__title">Table of Contents</h4>
    <ul id="toc-list" data-toc-list></ul>
  </div>
</nav>

<script>
  const root = document.querySelector('[data-toc]');
  const list = document.querySelector('[data-toc-list]');
  const toggle = document.querySelector('[data-toc-toggle]');
  if (root && list) {
    const article = document.querySelector('.prose');
    const headings = article ? Array.from(article.querySelectorAll('h2, h3')) : [];
    if (headings.length > 0) {
      root.removeAttribute('hidden');
      headings.forEach((el) => {
        if (!el.id) {
          el.id = (el.textContent || '')
            .toLowerCase()
            .replace(/[^\w\s-]/g, '')
            .replace(/\s+/g, '-');
        }
        const li = document.createElement('li');
        li.className = el.tagName === 'H3' ? 'toc__h3' : '';
        const a = document.createElement('a');
        a.href = `#${el.id}`;
        a.textContent = el.textContent || '';
        a.addEventListener('click', (e) => {
          e.preventDefault();
          document.getElementById(el.id)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        li.appendChild(a);
        list.appendChild(li);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length === 0) return;
          list.querySelectorAll('a').forEach((a) => a.classList.remove('is-active'));
          const match = list.querySelector(`a[href="#${visible[0].target.id}"]`);
          match?.classList.add('is-active');
        },
        { rootMargin: '-80px 0px -60% 0px', threshold: 0.1 }
      );
      headings.forEach((el) => observer.observe(el));
    }
  }
  toggle?.addEventListener('click', () => {
    const open = root?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
