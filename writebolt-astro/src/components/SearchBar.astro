---
import { publicPath } from '../lib/utils';

interface Props {
  query?: string;
}

const { query = '' } = Astro.props;
---

<form class="search-bar" role="search" action={publicPath('/')} method="get">
  <label for="blog-search" class="sr-only">Search articles</label>
  <div class="search-bar__field">
    <button type="submit" class="search-bar__icon" aria-label="Search">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
    </button>
    <input
      id="blog-search"
      type="search"
      name="q"
      value={query}
      placeholder="Search articles..."
      class="form-input search-bar__input"
    />
  </div>
</form>
