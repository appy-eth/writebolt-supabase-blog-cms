---
import type { SiteSettings } from '../lib/types';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const heading = settings.inline_cta_heading ?? '';
const sub = settings.inline_cta_subheading ?? '';
const placeholder = settings.inline_cta_email_placeholder?.trim() || 'Enter your email';
const buttonText = settings.inline_cta_button_text ?? 'Subscribe';
---

<div class="email-capture" data-email-capture role="complementary" aria-label="Email signup">
  <div data-ec-form-wrap>
    <h3>{heading}</h3>
    {sub && <p>{sub}</p>}
    <form class="email-capture__form" data-ec-form data-list-id={settings.inline_cta_list_id || ''} data-redirect={settings.inline_cta_success_redirect_url || ''}>
      <label for="inline-cta-email" class="sr-only">Email</label>
      <input id="inline-cta-email" type="email" required placeholder={placeholder} data-ec-email />
      <button type="submit" class="btn btn--primary" data-ec-submit>{buttonText}</button>
    </form>
    <p class="newsletter__error" data-ec-error hidden></p>
  </div>
  <div class="newsletter__success" data-ec-success hidden>
    <p>{settings.newsletter_success_message}</p>
  </div>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-ec-form]');
  if (form && !form.dataset.bound) {
    form.dataset.bound = 'true';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const wrap = form.closest('[data-email-capture]');
      const email = form.querySelector<HTMLInputElement>('[data-ec-email]')?.value.trim() || '';
      const errorEl = wrap?.querySelector<HTMLElement>('[data-ec-error]');
      const submit = form.querySelector<HTMLButtonElement>('[data-ec-submit]');
      if (!email || !wrap) return;
      submit && (submit.disabled = true);
      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
      try {
        const res = await fetch('/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            listIdOverride: form.dataset.listId || undefined,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (errorEl) {
            errorEl.hidden = false;
            errorEl.textContent = typeof data.error === 'string' ? data.error : 'Something went wrong.';
          }
          return;
        }
        const redirect = form.dataset.redirect?.trim();
        if (redirect) { window.location.href = redirect; return; }
        const formWrap = wrap.querySelector('[data-ec-form-wrap]');
        const success = wrap.querySelector('[data-ec-success]');
        if (formWrap) (formWrap as HTMLElement).hidden = true;
        if (success) (success as HTMLElement).hidden = false;
      } catch {
        if (errorEl) { errorEl.hidden = false; errorEl.textContent = 'Something went wrong. Please try again.'; }
      } finally {
        submit && (submit.disabled = false);
      }
    });
  }
</script>
