# Standalone installs: `npm run setup` writes this file.
# Add-on installs do not use this file. The wizard reads and updates the Astro site's own env
# (the .env or .env.local that already has the Supabase URL).

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Site (set during setup or manually)
SITE_URL=http://localhost:4321

# Public path prefix. Leave empty for a standalone blog (articles at /{slug}).
# Set to /blog when adding this blog to an existing website.
# The blog then loads that site's header, footer, and fonts.
# BLOG_BASE_PATH=/blog

# Origin of the existing site, used to read its header, footer, and CSS.
# Optional when SITE_URL is already that site. Set this in local dev when
# SITE_URL is the production domain and the site you are looking at is local.
# HOST_ORIGIN=http://localhost:4321

# Language code used in the Google News sitemap (default: en)
# NEWS_LANGUAGE=en

# Encrypts AI API keys stored in the database (openssl rand -hex 32)
SETTINGS_ENCRYPTION_KEY=

# Optional: newsletter subscribe API (wire your provider in /api/newsletter/subscribe)
# NEWSLETTER_API_KEY=

# Optional: Writebolt ads API override
# PUBLIC_WRITEBOLT_ADS_API_URL=https://api.writebolt.app
