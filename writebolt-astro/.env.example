# Writebolt Astro template — see ../README.md (repo root) for monorepo overview.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Site (set during setup or manually)
SITE_URL=http://localhost:4321

# Public path prefix. Leave empty for a standalone blog (articles at /{slug}).
# Set to /blog when adding this blog to an existing website.
# BLOG_BASE_PATH=/blog

# Language code used in the Google News sitemap (default: en)
# NEWS_LANGUAGE=en

# Encrypts AI API keys stored in the database (openssl rand -hex 32)
SETTINGS_ENCRYPTION_KEY=

# Optional: newsletter subscribe API (wire your provider in /api/newsletter/subscribe)
# NEWSLETTER_API_KEY=

# Optional: Writebolt ads API override
# PUBLIC_WRITEBOLT_ADS_API_URL=https://api.writebolt.app
